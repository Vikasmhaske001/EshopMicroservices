# Copy this file to .env (same directory) and fill in real values.
# docker compose automatically loads .env from this directory for ${VAR} substitution.
# .env itself is gitignored — never commit real secrets.

POSTGRES_PASSWORD=postgres
SA_PASSWORD=Password@123
RABBITMQ_PASSWORD=guest
CERT_PASSWORD=Password@123

# HMAC-SHA256 signing key shared by Identity.Api (issuer) and every resource service (validator).
# Must be identical across all services or token validation fails. Generate a strong random value
# for anything beyond local development — this is a placeholder, not a real secret.
JWT_KEY=dev-only-signing-key-do-not-use-in-production-CHANGE-ME-32chars+
